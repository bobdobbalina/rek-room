{
  "name": "rek-room",
  "version": "2.0.0",
  "description": "Zero-dependency CSS starting point for styling HTML primitives and components",
  "license": "ISC",
  "type": "module",
  "exports": {
    ".": "./dist/style.css",
    "./source": "./app/css/style.css",
    "./tokens": "./app/css/tokens/core.css",
    "./reset": "./app/css/reset.css"
  },
  "files": [
    "dist/style.css",
    "app/css/"
  ],
  "scripts": {
    "dev": "vite",
    "build": "lightningcss --bundle --minify app/css/style.css -o dist/steez.css",
    "prepublishOnly": "npm run build",
    "lint": "stylelint \"app/css/**/*.css\"",
    "lint:fix": "stylelint \"app/css/**/*.css\" --fix"
  },
  "devDependencies": {
    "lightningcss-cli": "^1.28.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^37.0.0",
    "vite": "^6.0.0"
  }
}